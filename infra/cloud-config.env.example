# Layer 6: Cloud & Compute - Provisioning & Compute Environment Spec

# Server Infrastructure Config
NODE_ENV=production
PORT=5000
CLUSTER_WORKERS=auto

# Database Compute Options
DATABASE_URL=mongodb://localhost:27017/resource-matcher
DB_MAX_POOL_SIZE=20

# Cloud Provider Settings (AWS / GCP / Azure)
CLOUD_PROVIDER=AWS
REGION=us-east-1
CDN_DOMAIN=cdn.resourcematcher.org

# Auth Secrets
JWT_SECRET=replace-with-a-secure-256-bit-key
JWT_EXPIRES_IN=7d
