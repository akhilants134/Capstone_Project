# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas (use your cluster connection string; include database name)
# Example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/resourcematcher?retryWrites=true&w=majority
MONGODB_URI=
DATABASE_URL=

# Auth
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=90d

# CORS — comma-separated allowed origins
CLIENT_URL=http://localhost:3000,http://localhost:5173

# Optional: 64-char hex key for 2FA secret encryption
TWO_FACTOR_ENCRYPTION_KEY=

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

